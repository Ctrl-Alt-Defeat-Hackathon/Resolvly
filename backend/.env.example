# Copy this to .env and fill in your keys

# LLM — OpenAI (required for demo / production LLM features)
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL_PRIMARY=gpt-4o-mini
OPENAI_MODEL_FALLBACK=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (optional local fallback when OpenAI fails — development only)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Google Cloud Vision API (fallback OCR, 1000 units/month free)
GOOGLE_VISION_API_KEY=

# Google Search API (fallback web search, 100 queries/day free)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# App settings
DEBUG=false

# LLM rate limiting (3 concurrent ≈ faster Action Plan; set to 1 if you hit OpenAI 429 errors)
LLM_MAX_CONCURRENT_REQUESTS=3
LLM_RETRY_ON_RATE_LIMIT=true
LLM_MIN_DELAY_BETWEEN_REQUESTS=0.1
