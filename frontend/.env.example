# --- Local dev (pick one approach) ---
# A) Local backend: leave VITE_API_BASE_URL unset; proxy /api to localhost:
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# B) Remote backend on Render — origin ONLY (no /api or /api/v1 path):
# VITE_API_URL=https://your-service.onrender.com

# --- Production (Vercel) ---
# Option 1: VITE_API_URL=https://your-service.onrender.com (direct to Render; needs CORS)
# Option 2: leave unset — vercel.json proxies /api/* to Render (same-origin, recommended)
